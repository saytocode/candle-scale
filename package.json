{
  "name": "@saytocode/candle-scale",
  "version": "0.3.1",
  "description": "Dependency-free, fixed-point-safe coordinate and geometry math for candlestick chart renderers.",
  "license": "MIT",
  "author": "saytocode",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chart",
    "candlestick",
    "trading",
    "typescript",
    "svg",
    "canvas",
    "fixed-point",
    "data-visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saytocode/candle-scale.git"
  },
  "bugs": {
    "url": "https://github.com/saytocode/candle-scale/issues"
  },
  "homepage": "https://github.com/saytocode/candle-scale#readme",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
